        "tool_name",
        "args",
        "session_id",
        "task_id",
        "tool_call_id",
        "turn_id"
      ],
      "payload": {
        "tool_name": "read_file",
        "args": {
          "path": "SENTINEL_ARG_VALUE/a.py"
        },
        "task_id": "task-1",
        "session_id": "sess-1",
        "tool_call_id": "call-1",
        "turn_id": "turn-1",
        "api_request_id": "req-1",
        "middleware_trace": []
      }
    },
    "post_tool_call": {
      "reads": [
        "tool_name",
        "args",
        "result",
        "session_id",
        "task_id",
        "tool_call_id",
        "turn_id",
        "duration_ms",
        "status",
        "error_type"
      ],
      "payload": {
        "tool_name": "read_file",
        "args": {
          "path": "SENTINEL_ARG_VALUE/a.py"
        },
        "result": "{\"content\": \"SENTINEL_RESULT\"}",
        "task_id": "task-1",
        "session_id": "sess-1",
        "tool_call_id": "call-1",
